generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ExpCharacter {
  id        Int           @id @default(autoincrement())
  assetKey  String        @unique
  name      String
  className String?
  job       String?
  server    String?
  worldId   String?
  guild     String?
  imageUrl  String?
  levelRank Int?
  rank      Int?
  level     Int?
  exp       BigInt?
  expPct    Float?
  dailyGain    BigInt?
  weeklyGain   BigInt?
  monthlyGain  BigInt?
  addedAt   DateTime      @default(now())
  snapshots ExpSnapshot[]
}

// Live EXP-per-level curve, keyed by level. Sourced from MSU's navigator /info
// `totalExp` field (the EXP required to complete that level, class-independent).
// The daily crawler refreshes these, so the table self-heals when MSU rebalances
// EXP. Overlaid on the static EXP_TABLE fallback in src/lib/expData.ts.
model ExpLevelReq {
  level     Int      @id
  totalExp  BigInt
  source    String? // "live" (from totalExp) | "provisional" (extrapolated)
  updatedAt DateTime @updatedAt
}

model ExpSnapshot {
  id          Int          @id @default(autoincrement())
  characterId Int
  level       Int
  exp         BigInt
  expPct      Float
  rank        Int?
  gain        BigInt?
  snappedAt   DateTime     @default(now())
  character   ExpCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, snappedAt])
  @@index([snappedAt])
}
